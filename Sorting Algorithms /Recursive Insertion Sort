
#include <iostream>
#include <vector>
using namespace std;


void recursiveInsertionSort(vector<int>& arr, int n) {
    if (n <= 1) {
        return;
    }

    recursiveInsertionSort(arr, n - 1);

    int last = arr[n - 1];
    int j = n - 2;

    while (j >= 0 && arr[j] > last) {
        arr[j + 1] = arr[j];
        j--;
    }

    arr[j + 1] = last;
}

int main() {
    int n;

    cout << "Enter the number of elements: ";
    cin >> n;

    if (n < 0) {
        cout << "Invalid array size.\n";
        return 1;
    }

    vector<int> arr(n);

    cout << "Enter " << n << " elements: ";
    for (int i = 0; i < n; i++) {
        cin >> arr[i];
    }

    recursiveInsertionSort(arr, n);

    cout << "Sorted array: ";
    for (int i = 0; i < n; i++) {
        cout << arr[i] << " ";
    }

    cout << '\n';
    return 0;
}

// Time: (O(n^2))
