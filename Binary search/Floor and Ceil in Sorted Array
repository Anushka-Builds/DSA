
#include <bits/stdc++.h>
using namespace std;

pair<int, int> getFloorAndCeil(vector<int>& nums, int x) {
    int low = 0;
    int high = nums.size() - 1;

    int floor = -1;
    int ceil = -1;

    while (low <= high) {
        int mid = low + (high - low) / 2;

        if (nums[mid] <= x) {
            floor = nums[mid];
            low = mid + 1;
        } 
        else {
            ceil = nums[mid];
            high = mid - 1;
        }
    }

    return {floor, ceil};
}

int main() {
    vector<int> nums = {1, 2, 4, 6, 8, 10};
    int x = 5;

    pair<int, int> ans = getFloorAndCeil(nums, x);

    cout << "Floor = " << ans.first << endl;
    cout << "Ceil = " << ans.second << endl;

    return 0;
}
//Time complexity: (O(log n))
// Extra space: (O(1))
