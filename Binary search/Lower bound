#include <iostream>
#include <vector>
using namespace std;

int lowerBound(vector<int>& nums, int x) {
    int n = nums.size();
    int low = 0;
    int high = n - 1;
    int ans = n;

    while (low <= high) {
        int mid = low + (high - low) / 2;

        if (nums[mid] >= x) {
            ans = mid;       // Possible answer
            high = mid - 1;  // Search for an earlier index
        } else {
            low = mid + 1;   // Need a larger element
        }
    }

    return ans;
}

int main() {
    int n;
    cout << "Enter array size: ";
    cin >> n;

    if (n < 0) {
        cout << "Invalid array size.\n";
        return 1;
    }

    vector<int> nums(n);

    cout << "Enter sorted array elements: ";
    for (int i = 0; i < n; i++) {
        cin >> nums[i];
    }

    int x;
    cout << "Enter x: ";
    cin >> x;

    cout << "Lower bound index: " << lowerBound(nums, x) << '\n';

    return 0;
}
// Time: O(logn) — binary search halves the search range each iteration.
// Auxiliary space: O(1) — only a few variables are used.
