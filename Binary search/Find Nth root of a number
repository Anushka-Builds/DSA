#include <iostream>
using namespace std;

int check(int mid, int n, int m) {
    long long ans = 1;

    for (int i = 1; i <= n; i++) {
        ans = ans * mid;

        if (ans > m)
            return 2;
    }

    if (ans == m)
        return 1;

    return 0;
}

int NthRoot(int n, int m) {
    int low = 1, high = m;

    while (low <= high) {
        int mid = low + (high - low) / 2;

        int result = check(mid, n, m);

        if (result == 1)
            return mid;

        else if (result == 0)
            low = mid + 1;

        else
            high = mid - 1;
    }

    return -1;
}

int main() {
    int n = 3;
    int m = 27;

    cout << NthRoot(n, m);

    return 0;
}
// Time Complexity: (O(N*log M))
// Space Complexity: (O(1))
