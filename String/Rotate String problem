#include <iostream>
#include <string>
using namespace std;

class Solution {
public:
    bool rotateString(string s, string goal) {

        // Lengths must be equal
        if (s.length() != goal.length()) {
            return false;
        }

        // Check if goal exists inside s + s
        string doubled = s + s;

        return doubled.find(goal) != string::npos;
    }
};

int main() {
    string s, goal;

    cin >> s >> goal;

    Solution obj;

    if (obj.rotateString(s, goal)) {
        cout << "true";
    } else {
        cout << "false";
    }

    return 0;
}
