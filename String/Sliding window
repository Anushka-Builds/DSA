// Time: O(n log k)
// Space: O(k)
// Leetcode no 480
#include <vector>
#include <set>
using namespace std;

class Solution {
public:
    multiset<int> low, high;

    void balance() {
        while (low.size() > high.size() + 1) {
            high.insert(*low.rbegin());
            auto it = prev(low.end());
            low.erase(it);
        }

        while (low.size() < high.size()) {
            low.insert(*high.begin());
            high.erase(high.begin());
        }
    }

    void insert(int num) {
        if (low.empty() || num <= *low.rbegin())
            low.insert(num);
        else
            high.insert(num);

        balance();
    }

    void remove(int num) {
        if (low.find(num) != low.end())
            low.erase(low.find(num));
        else
            high.erase(high.find(num));

        balance();
    }

    double getMedian(int k) {
        if (k % 2)
            return (double)(*low.rbegin());

        return ((double)(*low.rbegin()) + (double)(*high.begin())) / 2.0;
    }

    vector<double> medianSlidingWindow(vector<int>& nums, int k) {
        vector<double> ans;

        for (int i = 0; i < nums.size(); i++) {
            insert(nums[i]);

            if (i >= k)
                remove(nums[i - k]);

            if (i >= k - 1)
                ans.push_back(getMedian(k));
        }

        return ans;
    }
};
// Insertion: O(log k)
// Deletion: O(log k)
// Median: O(1)
