
#include <iostream>
#include <vector>
#include <unordered_map>
using namespace std;

int highestOccurringElement(vector<int>& arr) {
    unordered_map<int, int> freq;

    for (int i = 0; i < arr.size(); i++) {
        freq[arr[i]]++;
    }

    int highestElement = arr[0];
    int highestFrequency = 0;

    for (int i = 0; i < arr.size(); i++) {
        if (freq[arr[i]] > highestFrequency) {
            highestFrequency = freq[arr[i]];
            highestElement = arr[i];
        }
    }

    return highestElement;
}

int main() {
    int n;

    cout << "Enter array size: ";
    cin >> n;

    if (n <= 0) {
        cout << "Array size must be positive.\n";
        return 1;
    }

    vector<int> arr(n);

    cout << "Enter array elements: ";
    for (int i = 0; i < n; i++) {
        cin >> arr[i];
    }

    cout << "Highest occurring element: "
         << highestOccurringElement(arr) << '\n';

    return 0;
}
// Time: (O(n)) 
// Space: (O(k))
