#include <iostream>
#include <vector>
using namespace std;

int magicalString(int n) {
    if (n <= 0)
        return 0;

    if (n <= 3)
        return 1;

    vector<int> s = {1, 2, 2};

    int i = 2;
    int num = 1;
    int count1 = 1;

    while (s.size() < n) {

        for (int j = 0; j < s[i] && s.size() < n; j++) {
            s.push_back(num);

            if (num == 1)
                count1++;
        }

        num = 3 - num;

        i++;
    }

    return count1;
}

int main() {
    int n;

    cout << "Enter n: ";
    cin >> n;

    cout << "Number of 1s: " << magicalString(n) << endl;

    return 0;
}
// Time: O(n)
// Space: O(n)
